{
  "name": "cloakwp/image-transformations",
  "description": "Composable, PHP-configured image transformation pipelines for WordPress.",
  "type": "wordpress-muplugin",
  "license": "LGPL-3.0-only",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^1.0 || ^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "CloakWP\\ImageTransformations\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:wordpress": "wp eval-file tests/integration/wordpress.php --use-include"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "extra": {
    "installer-name": "image-transformations"
  }
}
